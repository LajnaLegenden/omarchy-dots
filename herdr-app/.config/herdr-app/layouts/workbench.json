{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "my-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "prs",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "my-prs"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main-stack",
              "type": "stack",
              "active": "main",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "hover",
                        "height": 30,
                        "position": "top"
                      },
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 2,
                        "color": "accent"
                      },
                      "radius": 14,
                      "gap": 12,
                      "lone": true,
                      "shadow": "md"
                    }
                  }
                },
                {
                  "id": "board",
                  "type": "block",
                  "content": {
                    "mod": "agent-board"
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 12,
          "gap": 12
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "my-status"
              }
            },
            {
              "id": "board-toggle",
              "type": "block",
              "size": {
                "px": 120
              },
              "content": {
                "mod": "agent-board",
                "props": {
                  "role": "button"
                }
              }
            }
          ]
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/omarchy.jpg",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "omarchy",
  "terminal_opacity": 0.7
}
