#!/usr/bin/env bash
# Run an autostart command, or notify-send instead of failing silently when
# the binary isn't installed (e.g. this dotfiles repo used on a fresh system).
set -euo pipefail

if [[ $# -eq 0 ]]; then
	echo "usage: launch-or-notify <command> [args...]" >&2
	exit 1
fi

if ! command -v "$1" >/dev/null 2>&1; then
	notify-send --urgency=critical "Autostart failed" "'$1' is not installed"
	exit 1
fi

exec "$@"
