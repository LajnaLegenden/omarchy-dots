#!/usr/bin/python3
"""Colony Monitor: a read-only window onto a MineColonies colony.

Reads the colony straight from the world save (refreshed whenever the game
autosaves, every few minutes) and tails the game log for a live feed of colony
chat. Never writes to the save.

One window: a sidebar of sections, opening on a dashboard (headline numbers
plus a preview of each section), then to do, open requests and builder work
orders, citizens (happiness, sickness, job), complaints, visitors and the live feed.

Usage: colony-monitor [path/to/instance]
"""

import gzip
import io
import json
import math
import os
import re
import struct
import sys
import time
import zipfile
import zlib
from glob import glob

import cairo
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk, Pango  # noqa: E402

INSTANCE = os.path.expanduser(
    sys.argv[1] if len(sys.argv) > 1 else
    "~/.local/share/atlauncher/instances/CREATEandCOLONYBetterfeatureswithCreateandMineColonies")
POLL_SECONDS = 3
FEED_LINES = 200
# Written by kubejs/server_scripts/colony_export.js while the world is running.
LIVE_EXPORT = os.path.join(INSTANCE, "kubejs", "exported", "colony.json")
LIVE_MAX_AGE = 15

# Request states, in the order of MineColonies' RequestState enum.
STATES = ["Created", "Reported", "Assigning", "Assigned", "In progress", "Resolved",
          "Follow-up", "Completed", "Failed", "Cancelled", "Received", "Overruled"]
OPEN_STATES = {0, 1, 2, 3, 4, 5, 6}

# Work order stages (BuildingStructureHandler.Stage).
# Skill enum order (the save stores the index).
SKILLS = ["Athletics", "Dexterity", "Strength", "Agility", "Stamina", "Mana",
          "Adaptability", "Focus", "Creativity", "Knowledge", "Intelligence"]
# Each job's primary and secondary skill (from MineColonies' BuildingModules).
JOB_SKILLS = {
    "Alchemist": ("Dexterity", "Mana"), "Archer": ("Agility", "Adaptability"),
    "Baker": ("Knowledge", "Dexterity"), "Beekeeper": ("Dexterity", "Adaptability"),
    "Blacksmith": ("Strength", "Focus"), "Builder": ("Adaptability", "Athletics"),
    "Chef": ("Creativity", "Knowledge"), "Chicken Herder": ("Adaptability", "Agility"),
    "Composter": ("Stamina", "Athletics"), "Concrete Mixer": ("Stamina", "Dexterity"),
    "Cook": ("Adaptability", "Knowledge"), "Cowhand": ("Athletics", "Stamina"),
    "Crusher": ("Stamina", "Strength"), "Courier": ("Agility", "Adaptability"),
    "Dyer": ("Creativity", "Dexterity"), "Enchanter": ("Mana", "Knowledge"),
    "Farmer": ("Stamina", "Athletics"), "Fisher": ("Focus", "Agility"),
    "Fletcher": ("Dexterity", "Creativity"), "Florist": ("Dexterity", "Agility"),
    "Glassblower": ("Creativity", "Focus"), "Healer": ("Mana", "Knowledge"),
    "Knight": ("Adaptability", "Stamina"), "Forester": ("Strength", "Focus"),
    "Mechanic": ("Knowledge", "Agility"), "Miner": ("Strength", "Stamina"),
    "Nether Miner": ("Adaptability", "Strength"), "Planter": ("Agility", "Dexterity"),
    "Quarrier": ("Strength", "Stamina"), "Rabbit Herder": ("Agility", "Athletics"),
    "Researcher": ("Knowledge", "Mana"), "Sawmill": ("Knowledge", "Dexterity"),
    "Shepherd": ("Focus", "Strength"), "Sifter": ("Focus", "Strength"),
    "Smelter": ("Athletics", "Strength"), "Stablemaster": ("Athletics", "Dexterity"),
    "Stonemason": ("Creativity", "Dexterity"), "Stone Smeltery": ("Athletics", "Dexterity"),
    "Swine Herder": ("Strength", "Athletics"), "Teacher": ("Knowledge", "Mana"),
    "Undertaker": ("Strength", "Mana"),
}


# Hut type -> the jobs it employs, for ranking against jobs the colony can offer.
HUT_JOBS = {
    "alchemist": ["Alchemist"], "baker": ["Baker"], "barracks": ["Knight", "Archer"],
    "barrackstower": ["Knight", "Archer"], "beekeeper": ["Beekeeper"], "blacksmith": ["Blacksmith"],
    "builder": ["Builder"], "chickenherder": ["Chicken Herder"], "composter": ["Composter"],
    "concretemixer": ["Concrete Mixer"], "cook": ["Cook"], "cowboy": ["Cowhand"], "crusher": ["Crusher"],
    "deliveryman": ["Courier"], "dyer": ["Dyer"], "enchanter": ["Enchanter"], "farmer": ["Farmer"],
    "fisherman": ["Fisher"], "fletcher": ["Fletcher"], "florist": ["Florist"], "glassblower": ["Glassblower"],
    "guardtower": ["Knight", "Archer"], "hospital": ["Healer"], "kitchen": ["Chef"], "lumberjack": ["Forester"],
    "mechanic": ["Mechanic"], "miner": ["Miner"], "netherworker": ["Nether Miner"], "plantation": ["Planter"],
    "quarrier": ["Quarrier"], "rabbithutch": ["Rabbit Herder"], "sawmill": ["Sawmill"], "school": ["Teacher"],
    "shepherd": ["Shepherd"], "sifter": ["Sifter"], "smeltery": ["Smelter"], "stable": ["Stablemaster"],
    "stonemason": ["Stonemason"], "stonesmeltery": ["Stone Smeltery"], "swineherder": ["Swine Herder"],
    "university": ["Researcher"], "graveyard": ["Undertaker"],
}


def colony_jobs(buildings):
    return {job for b in buildings.values() for job in HUT_JOBS.get(b["type"].split(":")[-1], [])}


def best_jobs(skills, n=3, only=None):
    """Jobs ranked by primary + secondary skill level."""
    scores = {job: skills.get(a, 0) + skills.get(b, 0) for job, (a, b) in JOB_SKILLS.items()
              if only is None or job in only}
    return sorted(scores.items(), key=lambda kv: -kv[1])[:n]


STAGES = ["Clearing", "Clearing", "Building solids", "Clearing water", "Building",
          "Decorating", "Spawning", "Removing", "Complete"]


# --- NBT ----------------------------------------------------------------------

def load_nbt(path):
    """Parse an NBT file (gzipped or not), or raw NBT bytes."""
    raw = path if isinstance(path, bytes) else open(path, "rb").read()
    try:
        raw = gzip.decompress(raw)
    except OSError:
        pass
    buf = io.BytesIO(raw)

    def read(fmt):
        return struct.unpack(">" + fmt, buf.read(struct.calcsize(fmt)))[0]

    def string():
        return buf.read(read("H")).decode("utf-8", "replace")

    def payload(tag):
        if tag == 1: return read("b")
        if tag == 2: return read("h")
        if tag == 3: return read("i")
        if tag == 4: return read("q")
        if tag == 5: return read("f")
        if tag == 6: return read("d")
        if tag == 7: buf.read(read("i")); return None
        if tag == 8: return string()
        if tag == 9:
            inner, n = read("b"), read("i")
            return [payload(inner) for _ in range(n)]
        if tag == 10:
            out = {}
            while (inner := read("b")) != 0:
                key = string()
                out[key] = payload(inner)
            return out
        if tag == 11: return [read("i") for _ in range(read("i"))]
        if tag == 12: return [read("q") for _ in range(read("i"))]
        raise ValueError(f"unknown NBT tag {tag}")

    tag = read("b")
    string()
    return payload(tag)


def unpack_pos(value):
    """BlockPos.asLong -> (x, y, z)."""
    def signed(v, bits):
        return v - (1 << bits) if v >= 1 << (bits - 1) else v
    value &= (1 << 64) - 1
    return (signed(value >> 38, 26), signed(value & 0xFFF, 12),
            signed((value >> 12) & 0x3FFFFFF, 26))


def pos_tuple(d):
    return (d.get("x"), d.get("y"), d.get("z")) if isinstance(d, dict) else None


def fmt_pos(p):
    return " ".join(str(v) for v in p) if p else "?"


# --- Text -----------------------------------------------------------------------

def load_lang():
    lang = {}
    for jar in glob(os.path.join(INSTANCE, "mods", "minecolonies-*.jar")):
        try:
            with zipfile.ZipFile(jar) as z:
                lang.update(json.loads(z.read("assets/minecolonies/lang/en_us.json")))
        except (OSError, KeyError, ValueError):
            pass
    return lang


LANG = load_lang()


def item_name(item_id):
    name = str(item_id).split(":", 1)[-1]
    return name.replace("_", " ").title()


def component_text(comp):
    """Render a JSON text component (possibly a JSON string) to plain text."""
    if isinstance(comp, str):
        try:
            comp = json.loads(comp)
        except ValueError:
            return comp
    if isinstance(comp, str):
        return comp
    if isinstance(comp, list):
        return "".join(component_text(c) for c in comp)
    if not isinstance(comp, dict):
        return str(comp)
    if "translate" in comp:
        key = comp["translate"]
        if key not in LANG and re.match(r"^(block|item)\.[\w.]+$", key):
            text = item_name(key.rsplit(".", 1)[-1])
        else:
            text = LANG.get(key, comp.get("fallback", key))
        args = [component_text(a) for a in comp.get("with", [])]
        try:
            text = re.sub(r"%(\d+\$)?s", "%s", text) % tuple(args) if args else text
        except TypeError:
            pass
    else:
        text = comp.get("text", "")
    return text + "".join(component_text(c) for c in comp.get("extra", []))


def building_name(btype):
    short = btype.split(":", 1)[-1]
    return LANG.get(f"com.minecolonies.building.{short}", short.replace("_", " ").title())


def job_name(jtype):
    short = jtype.split(":", 1)[-1]
    return LANG.get(f"com.minecolonies.job.{short}", short.replace("_", " ").title())


# Domum Ornamentum blocks (Architect's Cutter) are one item id per shape; the
# materials live in texture_data, keyed by the default texture they replace.
DOMUM_SLOTS = {"minecraft:block/oak_planks": "frame", "minecraft:block/dark_oak_planks": "centre"}


def domum_materials(stack):
    data = stack.get("components", {}).get("domum_ornamentum:texture_data")
    if not isinstance(data, dict):
        return ""
    if len(data) == 1:
        return item_name(next(iter(data.values())))
    return ", ".join(f"{DOMUM_SLOTS.get(slot, slot.rsplit('/', 1)[-1].replace('_', ' '))} {item_name(mat)}"
                     for slot, mat in data.items())


def describe_requested(req):
    """Human description of a request's 'Requested' payload."""
    if not isinstance(req, dict):
        return str(req)
    if "Type" in req and isinstance(req["Type"], str):      # tool request
        levels = ["Wood/Gold", "Stone", "Iron", "Diamond", "Netherite"]
        top = req.get("MaxLevel")
        tier = f" (up to {levels[top - 1]})" if isinstance(top, int) and 0 < top <= len(levels) else ""
        return f"{item_name(req['Type'])}{tier}"
    if "id" in req:                                          # item stack
        count = req.get("Count", req.get("count", 1))
        mats = domum_materials(req)
        return f"{count} × {item_name(req['id'])}" + (f" ({mats}; Architect's Cutter)" if mats else "")
    for key in ("Stack", "stack"):
        if isinstance(req.get(key), dict):
            inner = dict(req[key])
            inner["Count"] = req.get("Count", req.get("count", inner.get("count", 1)))
            return describe_requested(inner)
    for key in ("Stacks", "stacks", "List"):
        if isinstance(req.get(key), list) and req[key]:
            names = [describe_requested(s) for s in req[key][:3]]
            more = f" (+{len(req[key]) - 3} more)" if len(req[key]) > 3 else ""
            count = req.get("Count", req.get("count"))
            return (f"{count} of: " if count else "One of: ") + ", ".join(names) + more
    if "qty" in req:                                         # pickup: hut is full, courier collects
        qty = req["qty"]
        qty = qty.get("Data", {}).get("Value") if isinstance(qty, dict) else qty
        return f"Pickup: {qty} items for the courier to collect"
    if "Description" in req:
        return component_text(req["Description"])
    return ", ".join(f"{k}={v}" for k, v in req.items() if not isinstance(v, (dict, list)))[:80] or "?"


# --- Colony model ---------------------------------------------------------------

def find_save():
    paths = glob(os.path.join(INSTANCE, "saves", "*", "data", "minecolonies_colony_manager.dat"))
    return max(paths, key=os.path.getmtime) if paths else None


# Time-based factors (CitizenHappinessHandler): a value below 1 is multiplied by
# the last factor whose day threshold the modifier's day count has reached.
TIME_FACTORS = {
    "homelessness": [(7, 0.75), (14, 0.5)], "unemployment": [(7, 0.75), (14, 0.5)],
    "health": [(7, 0.5), (14, 0.1)], "idleatjob": [(7, 0.5), (14, 0.1)],
    # Days since last sleeping in a bed: 0.5 × 2 is neutral for the first two days.
    "slepttonight": [(0, 2.0), (2, 1.6), (3, 1.0)],
}


def happiness_value(mod):
    value = mod["supplier"].get("Value", 1)
    if mod.get("modifier") == "minecolonies:time" and value < 1:
        factor = value
        for day, mult in TIME_FACTORS.get(mod["id"], []):
            if mod.get("day", 0) >= day:
                factor = value * mult
        return factor
    return value


def happiness_active(mod):
    """Expiration modifiers only count while 0 < days <= period (otherwise neutral)."""
    if mod.get("modifier") != "minecolonies:expiration":
        return True
    return 0 < mod.get("day", 0) <= mod.get("period", 0)


def read_colony(path):
    root = load_nbt(path)["data"]["minecolonies"]["colonies"]
    if not root:
        raise ValueError("no colony in this world")
    col = root[0]

    buildings = {}
    for b in col["buildingManager"]["buildings"]:
        p = pos_tuple(b.get("location"))
        buildings[p] = {"type": b["type"], "level": b.get("level", 0), "pos": p,
                        "name": b.get("customName") or building_name(b["type"])}

    citizens = []
    for c in col["citizenManager"]["citizens"]:
        job = c.get("job") if isinstance(c.get("job"), dict) else {}
        mods = [m for m in c.get("newhappinesshandler", []) if happiness_active(m)]
        # Like CitizenHappinessHandler: neutral factors (exactly 1.0) are left out of
        # the average, so a few bad ones weigh heavily. Research bonuses aren't known here.
        counted = [m for m in mods if happiness_value(m) != 1]
        total_w = sum(m.get("weight", 0) for m in counted)
        score = min(10.0, sum(m.get("weight", 0) * happiness_value(m) for m in counted)
                    / total_w * 10) if total_w else 10.0
        # (effective value, factor, raw value); the raw value carries e.g. the home level.
        weak = sorted((happiness_value(m), m["id"], m["supplier"].get("Value", 1)) for m in mods
                      if happiness_value(m) < 1)
        disease = c.get("disease", {})
        sick = disease.get("disease") or disease.get("Disease") or disease.get("id")
        complaints = []
        for opt in c.get("chatoptions", []):
            o = opt.get("chatoption", {})
            if o.get("inquiry"):
                complaints.append({"text": component_text(o["inquiry"]), "priority": o.get("priority", 0)})
        citizens.append({
            "name": c["name"], "id": c.get("id"),
            "job": job_name(job["type"]) if job.get("type") else "Unemployed",
            "workpos": pos_tuple(job.get("workPos")),
            "child": bool(c.get("child")),
            "happiness": score, "weak": weak,
            "sick": sick, "complaints": complaints,
            "saturation": c.get("saturation", 0),
        })

    requests = []

    def walk(node):
        if isinstance(node, dict):
            if "Requested" in node and "State" in node:
                requests.append(node)
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(col["requestManager"])
    open_requests = []
    for r in requests:
        if r.get("State") not in OPEN_STATES:
            continue
        loc = r.get("Requester", {}).get("Data", {}).get("Location", {}).get("Data", {}).get("Pos")
        p = unpack_pos(loc) if isinstance(loc, int) else None
        b = buildings.get(p)
        open_requests.append({
            "what": describe_requested(r["Requested"]),
            "state": STATES[r["State"]] if r["State"] < len(STATES) else str(r["State"]),
            "who": b["name"] if b else fmt_pos(p),
            "worker": next((c["name"] for c in citizens if c["workpos"] == p), None),
        })

    orders = []
    for w in col.get("work", {}).get("workOrders", []):
        builder = pos_tuple(w.get("claimedByBuilding"))
        orders.append({
            "what": component_text({"translate": w.get("translationKey", "")}) or w.get("structurePath", "?"),
            "level": f"{w.get('currentLevel', 0)} → {w.get('targetLevel', 1)}",
            "stage": STAGES[w["stage"]] if isinstance(w.get("stage"), int) and w["stage"] < len(STAGES) else "",
            "builder": next((c["name"] for c in citizens if builder and c["workpos"] == builder), "Unclaimed"),
            "pos": fmt_pos(pos_tuple(w.get("location"))),
            "resources": w.get("amountOfResources"),
        })

    visitors = []
    for v in col.get("visitManager", {}).get("visitors", []):
        levels = v.get("newSkills", {}).get("levelMap", [])
        skills = {SKILLS[s["skill"]]: s.get("level", 0) for s in levels if s.get("skill", 99) < len(SKILLS)}
        cost = v.get("rcost", {})
        visitors.append({
            "name": v["name"],
            "cost": f"{v.get('rcostqty', cost.get('count', 1))} × {item_name(cost['id'])}" if cost.get("id") else "?",
            "skills": skills,
        })

    research = {}
    for r in col.get("research", {}).get("researchTree", []):
        d = r.get("Data", r)
        if d.get("id"):
            research[d["id"]] = {"state": d.get("state", 0), "progress": d.get("progress", 0)}

    return {"name": col.get("name", "Colony"), "day": col.get("colonyday"),
            "citizens": citizens, "requests": open_requests, "orders": orders,
            "visitors": visitors, "buildings": buildings, "research": research}


def read_live(path):
    """The in-game KubeJS export, if the game wrote it recently; else None."""
    try:
        with open(path) as f:
            live = json.load(f)
    except (OSError, ValueError):
        return None
    if time.time() - live.get("exportedAt", 0) / 1000 > LIVE_MAX_AGE or not live.get("colonies"):
        return None
    return live


def apply_live(col, live):
    """Overlay the live export on the save model. Complaints and happiness
    factors only exist in the save, so those are kept from it."""
    lc = live["colonies"][0]
    col["name"], col["day"] = lc.get("name", col["name"]), lc.get("day") or col["day"]
    col["live"] = True
    col["errors"] = live.get("errors", {})

    saved = {c["name"]: c for c in col["citizens"]}
    by_pos = {}
    citizens = []
    for lcit in lc.get("citizens", []):
        c = dict(saved.get(lcit["name"], {"weak": [], "complaints": []}))
        job = lcit.get("job")
        c.update({
            "name": lcit["name"], "child": lcit.get("child", False),
            "job": job_name(job) if job else "Unemployed",
            "workpos": tuple(lcit["work"]) if lcit.get("work") else None,
            "sick": lcit["sick"]["name"] if lcit.get("sick") else None,
            "cure": lcit["sick"]["cure"] if lcit.get("sick") else None,
            "health": lcit.get("health"), "max_health": lcit.get("maxHealth"),
            "saturation": lcit.get("saturation", c.get("saturation", 0)),
            "status": component_text({"translate": lcit["status"]}) if lcit.get("status") else None,
            "asleep": lcit.get("asleep"),
        })
        if lcit.get("happiness") is not None:
            c["happiness"] = lcit["happiness"]
        citizens.append(c)
        if c["workpos"]:
            by_pos[c["workpos"]] = c["name"]
    col["citizens"] = citizens

    requests = []
    for b in lc.get("buildings", []):
        for r in b.get("requests", []):
            items = r.get("items") or []
            pickup = r.get("type") == "Pickup"
            if pickup and b.get("contents"):
                top = sorted(b["contents"].items(), key=lambda kv: -kv[1])
                items = [f"{n} × {name}" for name, n in top[:8]]
            requests.append({
                "what": r.get("what") or r.get("detail") or r.get("type"),
                "state": r.get("state", "").replace("_", " ").capitalize(),
                "who": LANG.get(b["name"], b["name"]), "worker": by_pos.get(tuple(b["pos"])),
                "items": items, "pickup": pickup,
                "resolver": r.get("resolver"),
                "waiting": [f"{c['what']} ({c['resolver'] or '?'})" for c in r.get("children") or []],
            })
    col["requests"] = requests

    orders = []
    for o in lc.get("orders", []):
        builder = tuple(o["builder"]) if o.get("builder") else None
        orders.append({
            "what": o["what"], "level": f"{o['level'][0]} → {o['level'][1]}",
            "stage": (o.get("stage") or "").replace("_", " ").capitalize(),
            "builder": by_pos.get(builder, "Unclaimed"),
            "pos": fmt_pos(o.get("pos")), "resources": None,
        })
    col["orders"] = orders

    col["todo"] = [{
        "what": t.get("what") or t.get("detail"),
        "who": t.get("requester") or fmt_pos(t.get("pos")),
        "worker": by_pos.get(tuple(t["pos"])) if t.get("pos") else None,
        "items": t.get("items") or [],
        "retrying": t.get("handler") == "retrying",
    } for t in lc.get("todo", [])]
    col["housing"] = lc.get("housing")
    col["warehouse"] = {}
    for b in lc.get("buildings", []):
        if b.get("type") == "minecolonies:warehouse":
            for name, n in (b.get("contents") or {}).items():
                col["warehouse"][name] = col["warehouse"].get(name, 0) + n
    col["crafts"] = lc.get("crafts") or {}
    col["building_types"] = sorted({b["type"].split(":")[-1] for b in lc.get("buildings", []) if b.get("type")})
    for t in col["todo"]:
        t["maker"] = colony_maker(col, t["what"])

    # Dining Halls and what's on hand for each menu item. None when the export
    # predates menus (the game needs a /reload to pick up the new script).
    col["dining"] = None
    if any("menu" in b for b in lc.get("buildings", [])):
        col["dining"] = []
        for b in lc["buildings"]:
            # The Nether Worker has a menu too (food it packs for trips); that's no Dining Hall.
            if b.get("menu") is None or b.get("type") != "minecolonies:cook":
                continue
            hall = b.get("contents") or {}
            items = []
            for name in dict.fromkeys(b["menu"]):
                raw = COOKED.get(name)
                items.append({
                    "name": name, "hall": hall.get(name, 0), "warehouse": col["warehouse"].get(name, 0),
                    "raw_name": raw,
                    "raw": (hall.get(raw, 0) + col["warehouse"].get(raw, 0)) if raw else 0,
                    "maker": colony_maker(col, name),
                })
            col["dining"].append({"name": LANG.get(b["name"], b["name"]), "level": b.get("level"),
                                  "pos": fmt_pos(b.get("pos")), "menu": items})

    if "visitors" in lc:
        col["visitors"] = [{"name": v["name"], "cost": v.get("cost") or "?", "skills": v.get("skills") or {}}
                           for v in lc["visitors"]]
    return col


# --- Research -------------------------------------------------------------------

# Research progress units at depth 1 (ResearchConstants.BASE_RESEARCH_TIME); each
# depth doubles it. The University GUI shows units × 25 / 3600 as hours.
RESEARCH_BASE = 72
RESEARCH_DONE, RESEARCH_RUNNING = 2, 1


def load_research():
    """The global research tree from every mod jar (MineColonies, addons):
    (branches by id, researches by id). Also merges the jars' lang files into
    LANG, since addon research names live there."""
    branches, researches = {}, {}
    for jar in sorted(glob(os.path.join(INSTANCE, "mods", "*.jar"))):
        try:
            with zipfile.ZipFile(jar) as z:
                names = [n for n in z.namelist() if re.match(r"data/[^/]+/researches/.+\.json$", n)]
                if not names:
                    continue
                for n in z.namelist():
                    if re.match(r"assets/[^/]+/lang/en_us\.json$", n):
                        for k, v in json.loads(z.read(n)).items():
                            LANG.setdefault(k, v)
                effects = {}
                for n in names:
                    ns, path = re.match(r"data/([^/]+)/researches/(.+)\.json$", n).groups()
                    d = json.loads(z.read(n))
                    rid = f"{ns}:{path}"
                    if "/" not in path:
                        branches[rid] = d
                    elif d.get("effect"):
                        effects[rid] = d.get("levels") or []
                    elif "branch" in d:
                        researches[rid] = dict(d, id=rid)
                for r in researches.values():
                    for e in r.get("effects", []):
                        if e.get("id") in effects:
                            e["levels"] = effects[e["id"]]
        except (OSError, KeyError, ValueError):
            continue
    return branches, researches


def java_format(text, args):
    """Fill a Java format string ('+%3$s%%', '%s', '%d') with `args`."""
    seq = iter(args)

    def sub(m):
        if m.group(0) == "%%":
            return "%"
        if m.group(1):
            i = int(m.group(1)) - 1
            return str(args[i]) if i < len(args) else ""
        return str(next(seq, ""))
    return re.sub(r"%%|%(?:(\d+)\$)?[sd]", sub, text)


def research_lang(rid, part):
    ns, path = rid.split(":", 1)
    return LANG.get(f"com.{ns}.research.{path.replace('/', '.')}.{part}")


def research_name(r):
    return research_lang(r["id"], "name") or item_name(r["id"].rsplit("/", 1)[-1])


def effect_text(e):
    ns, path = e["id"].split(":", 1)
    text = LANG.get(f"com.{ns}.research.{path.replace('/', '.')}.description")
    if not text:
        return item_name(path.rsplit("/", 1)[-1])
    levels = e.get("levels") or []
    lvl = e.get("level", 1)
    value = levels[lvl - 1] if 0 < lvl <= len(levels) else lvl
    num = lambda v: f"{v:g}"
    # GlobalResearchEffect's arguments: the strength, as is and as a percentage.
    return java_format(text, [num(value), num(value), num(round(value * 100, 1))])


def cost_text(c):
    what = item_name(c["item"]) if c.get("item") else "any " + item_name(c.get("tag", "?"))
    return f"{c.get('count', 1)} {what}"


def requirement_check(req, buildings):
    """(text, met) for one building requirement. 'building' sums the levels of
    every hut of that type; 'single-building' needs one hut at that level."""
    level = req.get("level", 1)
    types = req.get("alternate-buildings") or [req.get("building", "?")]
    have = [b["level"] for b in buildings.values() if b["type"] in types]
    if req.get("type") == "minecolonies:single-building":
        got = max(have, default=0)
    else:
        got = sum(have)
    names = " or ".join(building_name(t) for t in types)
    if req.get("type") == "minecolonies:single-building" or len(have) <= 1:
        text = f"{names} level {level}"
    else:
        text = f"{names} levels totalling {level}"
    return f"{text} (have {got})", got >= level


def research_status(r, col, tree, uni_level):
    """('done'|'running'|'available'|'blocked'|'locked', percent, reasons) for one research."""
    state = col["research"].get(r["id"], {})
    need = RESEARCH_BASE * TREE_BRANCHES.get(r["branch"], {}).get("base-time", 1.0) * 2 ** (r["researchLevel"] - 1)
    if state.get("state") == RESEARCH_DONE:
        return "done", 100, []
    if state.get("state") == RESEARCH_RUNNING:
        return "running", min(99, int(100 * state.get("progress", 0) / max(1, need))), []
    parent = r.get("parentResearch")
    if parent and col["research"].get(parent, {}).get("state") != RESEARCH_DONE:
        return "locked", 0, [f"Research {research_name(tree[parent])} first" if parent in tree else parent]
    reasons = []
    # Exclusive parents allow only one of their children.
    if parent and tree.get(parent, {}).get("exclusiveChildResearch"):
        taken = [s for s in tree.values() if s.get("parentResearch") == parent and s["id"] != r["id"]
                 and col["research"].get(s["id"], {}).get("state") in (RESEARCH_DONE, RESEARCH_RUNNING)]
        if taken:
            return "locked", 0, [f"Excluded: you picked {research_name(taken[0])}"]
    if r["researchLevel"] > uni_level:
        reasons.append(f"University level {min(r['researchLevel'], 5)}" + (" (max)" if r["researchLevel"] == 6 else ""))
    for req in r.get("requirements", []):
        text, met = requirement_check(req, col["buildings"])
        if not met:
            reasons.append(text)
    return ("blocked" if reasons else "available"), 0, reasons


def research_duration(r):
    hours = RESEARCH_BASE * TREE_BRANCHES.get(r["branch"], {}).get("base-time", 1.0) \
        * 2 ** (r["researchLevel"] - 1) * 25 / 3600
    return f"{hours * 60:.0f} min" if hours < 1 else f"{hours:g} h"


TREE_BRANCHES, TREE = load_research()


# --- Bounties -------------------------------------------------------------------

# Create Numismatics coins in spurs (Coin enum).
COIN_SPURS = {"numismatics:spur": 1, "numismatics:bevel": 8, "numismatics:sprocket": 16,
              "numismatics:cog": 64, "numismatics:crown": 512, "numismatics:sun": 4096}
BOUNTY_RADIUS = 768      # blocks around you and the Town Hall
REGION_CACHE = {}        # region path -> (mtime, boards found in it)


def region_boards(path, rx, rz):
    """Bountiful boards saved in one region file: [{'pos', 'bounties'}]."""
    mtime = os.path.getmtime(path)
    cached = REGION_CACHE.get(path)
    if cached and cached[0] == mtime:
        return cached[1]
    boards = []
    data = open(path, "rb").read()
    for i in range(1024):
        off = struct.unpack(">I", b"\0" + data[i * 4:i * 4 + 3])[0]
        if not off or data[off * 4096 + 4] != 2:     # 2 = zlib
            continue
        p = off * 4096
        try:
            raw = zlib.decompress(data[p + 5:p + 4 + struct.unpack(">I", data[p:p + 4])[0]])
        except zlib.error:
            continue
        if b"bountiful:board" not in raw:
            continue
        for be in load_nbt(raw).get("block_entities", []):
            if not str(be.get("id", "")).startswith("bountiful:board"):
                continue
            bounties = []
            for it in be.get("bounty_inv", {}).get("Items", []):
                comp = it.get("components", {})
                info = comp.get("bountiful:bounty_info", {})
                bounties.append({
                    "rarity": info.get("rarity", "COMMON"),
                    "expires": info.get("timeStarted", 0) + info.get("timeToComplete", 0) * 20,
                    "rewards": [(r.get("logicName", ""), r.get("content", "?"), r.get("amount", 1))
                                for r in comp.get("bountiful:rewards", [])],
                    "objects": [(o.get("logicName", ""), o.get("content", "?"), o.get("amount", 1))
                                for o in comp.get("bountiful:objects", [])],
                })
            boards.append({"pos": (be.get("x"), be.get("y"), be.get("z")), "bounties": bounties})
    REGION_CACHE[path] = (mtime, boards)
    return boards


def read_bounties(world, centers):
    """Boards within BOUNTY_RADIUS of any of `centers` ((x, z) pairs), plus the
    world's game time (bounty expiry is in game ticks)."""
    regions = set()
    for cx, cz in centers:
        for rx in range((cx - BOUNTY_RADIUS) // 512, (cx + BOUNTY_RADIUS) // 512 + 1):
            for rz in range((cz - BOUNTY_RADIUS) // 512, (cz + BOUNTY_RADIUS) // 512 + 1):
                regions.add((rx, rz))
    boards = []
    for rx, rz in sorted(regions):
        path = os.path.join(world, "region", f"r.{rx}.{rz}.mca")
        if os.path.exists(path) and os.path.getsize(path):
            try:
                boards += region_boards(path, rx, rz)
            except (OSError, ValueError, struct.error, IndexError):
                continue
    near = [b for b in boards if any(abs(b["pos"][0] - cx) <= BOUNTY_RADIUS and abs(b["pos"][2] - cz) <= BOUNTY_RADIUS
                                     for cx, cz in centers)]
    return near


def player_pos(world):
    """Your saved position (x, z) in the Overworld, or None."""
    paths = glob(os.path.join(world, "playerdata", "*.dat"))
    if not paths:
        return None
    try:
        p = load_nbt(max(paths, key=os.path.getmtime))
    except (OSError, ValueError, struct.error):
        return None
    if p.get("Dimension", "minecraft:overworld") != "minecraft:overworld" or len(p.get("Pos", [])) < 3:
        return None
    return int(p["Pos"][0]), int(p["Pos"][2])


def game_time(world):
    try:
        return load_nbt(os.path.join(world, "level.dat"))["Data"]["Time"]
    except (OSError, ValueError, KeyError, struct.error):
        return 0


def spurs(entries):
    return sum(COIN_SPURS.get(i, 0) * n for _, i, n in entries)


def display_name(item_id):
    if ASSETS is not None:
        if not hasattr(ASSETS, "by_id"):
            ASSETS.by_id = {}
            for name, iid in ASSETS.names.items():
                ASSETS.by_id.setdefault(iid, name.title())
        if item_id in ASSETS.by_id:
            return ASSETS.by_id[item_id]
    return item_name(item_id)


def entry_text(logic, item_id, n):
    if "entity" in logic:
        return f"kill {n} {display_name(item_id)}"
    if logic and "item" not in logic:
        return f"{n} {item_name(item_id)} ({logic.split(':')[-1]})"
    return f"{n} {display_name(item_id)}"


def compass(dx, dz):
    if abs(dx) < 16 and abs(dz) < 16:
        return "right here"
    dirs = ["E", "SE", "S", "SW", "W", "NW", "N", "NE"]   # +z is south
    d = dirs[round(math.atan2(dz, dx) / (math.pi / 4)) % 8]
    return f"{round(math.hypot(dx, dz))} blocks {d}"


HAPPINESS_LABELS = {
    "homelessness": "No home", "security": "Feels unsafe", "social": "Lonely",
    "food": "Hungry / poor food", "health": "Unwell", "unemployment": "Unemployed",
    "idleatjob": "Idle at work", "slepttonight": "Didn't sleep", "school": "No school",
    "mysticalsite": "No mystical site", "damage": "Got hurt", "death": "Saw a death",
    "raidwithoutdeath": "Raid", "sleptinbed": "No bed",
}


def weak_label(value, factor):
    # MineColonies calls it "homelessness", but the value is home level / 3:
    # 0 only without a home, and below 1 for any home under level 3.
    if factor == "homelessness" and value > 0:
        return f"Home only level {round(value * 3)} (wants 3)"
    return HAPPINESS_LABELS.get(factor, factor)


def read_feed(path):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 400_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []
    feed = []
    for line in lines:
        m = re.match(r"\[[^\]]*?(\d\d:\d\d:\d\d)[^\]]*\].*\[CHAT\] (.*)", line)
        if m:
            feed.append((m.group(1), m.group(2).strip()))
    return feed[-FEED_LINES:]


# --- Game icons -----------------------------------------------------------------
# Item and block textures straight from the game's jars (vanilla client + mods),
# found through each item's model so they look like the inventory: flat items
# as their sprite, blocks as a small isometric cube.

ICON_RENDER = 64   # drawn at 2× the display size so it stays crisp on HiDPI
ICON_CACHE = os.path.expanduser("~/.cache/colony-monitor/assets.json")

# Request text that names a kind of tool rather than an item.
TOOL_ICONS = [("pickaxe", "minecraft:iron_pickaxe"), ("axe", "minecraft:iron_axe"),
              ("shovel", "minecraft:iron_shovel"), ("hoe", "minecraft:iron_hoe"),
              ("sword", "minecraft:iron_sword"), ("bow", "minecraft:bow"),
