              ("leggings", "minecraft:iron_leggings"), ("boots", "minecraft:iron_boots"),
              ("food", "minecraft:bread"), ("fuel", "minecraft:coal"), ("pickup", "minecraft:barrel")]

# An item that stands for each job.
JOB_ICONS = {
    "Alchemist": "minecraft:brewing_stand", "Archer": "minecraft:bow", "Baker": "minecraft:bread",
    "Beekeeper": "minecraft:honeycomb", "Blacksmith": "minecraft:iron_chestplate",
    "Builder": "minecolonies:sceptergold", "Chef": "minecraft:mushroom_stew", "Chicken Herder": "minecraft:egg",
    "Composter": "minecraft:bone_meal", "Concrete Mixer": "minecraft:white_concrete_powder",
    "Cook": "minecraft:cooked_beef", "Waiter": "minecraft:cooked_beef", "Cowhand": "minecraft:milk_bucket", "Crusher": "minecraft:gravel",
    "Courier": "minecraft:minecart", "Dyer": "minecraft:red_dye", "Enchanter": "minecraft:enchanted_book",
    "Farmer": "minecraft:wheat", "Fisher": "minecraft:fishing_rod", "Fletcher": "minecraft:arrow",
    "Florist": "minecraft:poppy", "Glassblower": "minecraft:glass", "Healer": "minecraft:golden_apple",
    "Knight": "minecraft:iron_sword", "Forester": "minecraft:iron_axe", "Mechanic": "minecraft:redstone",
    "Miner": "minecraft:iron_pickaxe", "Nether Miner": "minecraft:netherrack", "Planter": "minecraft:sugar_cane",
    "Quarrier": "minecraft:cobblestone", "Rabbit Herder": "minecraft:rabbit_foot",
    "Researcher": "minecolonies:ancienttome", "Sawmill": "minecraft:oak_planks", "Shepherd": "minecraft:white_wool",
    "Sifter": "minecolonies:sifter_mesh_string", "Smelter": "minecraft:iron_ingot", "Stablemaster": "minecraft:saddle",
    "Stonemason": "minecraft:stone_bricks", "Stone Smeltery": "minecraft:smooth_stone",
