class GameAssets:
    def __init__(self):
        mods = sorted(glob(os.path.join(INSTANCE, "mods", "*.jar")))
        version = next((m.group(1) for j in mods
                        if (m := re.search(r"minecolonies-[\d.]+-(\d[\d.]*\d)\.jar$", j))), None)
        client = os.path.join(INSTANCE, "..", "..", "libraries", "net", "minecraft", "client",
                              str(version), f"client-{version}.jar")
        # Vanilla first: on a name or path clash, the vanilla asset wins.
        self.jars = [os.path.normpath(client)] * os.path.exists(client) + mods
        self.files = {}   # asset path -> jar holding it
        self.names = {}   # lowercase display name -> item id
        self.zips = {}
        self.icons = {}
        self.load_index()

    def load_index(self):
        sig = [[j, os.path.getmtime(j)] for j in self.jars]
        try:
            with open(ICON_CACHE) as f:
                cached = json.load(f)
            if cached["sig"] == sig:
                self.files, self.names = cached["files"], cached["names"]
                return
        except (OSError, ValueError, KeyError):
            pass
        for jar in self.jars:
            try:
                z = zipfile.ZipFile(jar)
            except (OSError, zipfile.BadZipFile):
                continue
            with z:
                for n in z.namelist():
                    if not n.startswith("assets/"):
                        continue
                    if ("/models/" in n and n.endswith(".json")) or ("/textures/" in n and n.endswith(".png")):
                        self.files.setdefault(n, jar)
                    elif n.endswith("/lang/en_us.json"):
                        try:
                            lang = json.loads(z.read(n))
                        except ValueError:
                            continue
                        for key, name in lang.items():
                            parts = key.split(".")
                            if len(parts) == 3 and parts[0] in ("item", "block") and isinstance(name, str):
                                self.names.setdefault(name.lower(), f"{parts[1]}:{parts[2]}")
        try:
            os.makedirs(os.path.dirname(ICON_CACHE), exist_ok=True)
            with open(ICON_CACHE, "w") as f:
                json.dump({"sig": sig, "files": self.files, "names": self.names}, f)
        except OSError:
            pass

    def read(self, asset):
        jar = self.files.get(asset)
        if not jar:
            return None
        if jar not in self.zips:
            self.zips[jar] = zipfile.ZipFile(jar)
        return self.zips[jar].read(asset)

    def model(self, ref):
        ns, _, path = ref.rpartition(":")
        data = self.read(f"assets/{ns or 'minecraft'}/models/{path}.json")
        try:
            return json.loads(data) if data else None
        except ValueError:
            return None

    def textures_for(self, item_id):
        """('flat', [layers]) or ('cube', [top, side]) as texture refs."""
        ns, _, path = item_id.partition(":")
        textures, ref = {}, f"{ns}:item/{path}"
        for _ in range(12):     # parent chain
            m = self.model(ref)
            if m is None:
                break
            for k, v in (m.get("textures") or {}).items():
                textures.setdefault(k, v)
            ref = m.get("parent")
            if not ref:
                break

        def resolve(v):
            for _ in range(5):
                if not (isinstance(v, str) and v.startswith("#")):
                    break
                v = textures.get(v[1:])
            return v if isinstance(v, str) and not v.startswith("#") else None

        tex = {k: r for k, v in textures.items() if (r := resolve(v))}
        layers = [tex[f"layer{i}"] for i in range(5) if f"layer{i}" in tex]
        if layers:
            return "flat", layers
        if tex:
            def pick(*keys):
                return next((tex[k] for k in keys if k in tex), next(iter(tex.values())))
            return "cube", [pick("top", "end", "up", "all", "texture", "particle"),
                            pick("side", "front", "north", "all", "texture", "particle")]
        if f"assets/{ns}/textures/item/{path}.png" in self.files:
            return "flat", [f"{ns}:item/{path}"]
        if f"assets/{ns}/textures/block/{path}.png" in self.files:
            return "cube", [f"{ns}:block/{path}"] * 2
        return None, []

    def surface(self, ref):
        ns, _, path = ref.rpartition(":")
        data = self.read(f"assets/{ns or 'minecraft'}/textures/{path}.png")
        try:
            return cairo.ImageSurface.create_from_png(io.BytesIO(data)) if data else None
        except (cairo.Error, MemoryError):
            return None

    def icon(self, item_id=None, texture=None):
        """A Gdk.Texture for an item id, or for a raw texture ref; None if unknown."""
        key = item_id or texture
        if not key:
            return None
        if key not in self.icons:
            kind, refs = ("flat", [texture]) if texture else self.textures_for(item_id)
            surfs = [self.surface(r) for r in refs]
            self.icons[key] = draw_icon(kind, surfs) if surfs and all(surfs) else None
        return self.icons[key]

    def find(self, text):
        """Item id for request text like '1-3 Smooth Stone' or '40 × Leather'."""
        s = re.sub(r"\(.*?\)", "", str(text or ""))
        s = re.sub(r"^\s*\d+(\s*-\s*\d+)?\s*[×x]?\s+", "", s).strip().lower()
        if s in self.names:
            return self.names[s]
        if s.endswith("s") and s[:-1] in self.names:
            return self.names[s[:-1]]
        # Architect's Cutter blocks: show the main material, e.g. "(centre Bricks, frame Spruce Planks)".
        for part in re.split(r"[,;]", "".join(re.findall(r"\((.*?)\)", str(text or "")))):
            mat = re.sub(r"^\s*(centre|center|frame|side|top|main)\s+", "", part).strip().lower()
            if mat in self.names:
                return self.names[mat]
        if "architect's cutter" in str(text).lower():
            return "domum_ornamentum:architectscutter"
        return next((item for word, item in TOOL_ICONS if word in s), None)


def draw_icon(kind, surfs):
    S = ICON_RENDER
    out = cairo.ImageSurface(cairo.FORMAT_ARGB32, S, S)
    ctx = cairo.Context(out)

    def paint(surf, matrix, shade=0.0):
        w = surf.get_width()   # animated textures are a tall strip; use the first frame
        ctx.save()
        ctx.transform(matrix)
        ctx.scale(16 / w, 16 / w)
        ctx.rectangle(0, 0, w, w)
        ctx.clip()
        ctx.set_source_surface(surf, 0, 0)
        ctx.get_source().set_filter(cairo.FILTER_NEAREST)
        ctx.paint()
        if shade:
            ctx.set_operator(cairo.OPERATOR_ATOP)
            ctx.set_source_rgba(0, 0, 0, shade)
            ctx.paint()
        ctx.restore()

    if kind == "flat":
        for surf in surfs:
            paint(surf, cairo.Matrix(S / 16, 0, 0, S / 16, 0, 0))
    else:
        # Matrices map a 16×16 face onto the top, left and right of an isometric cube.
        top, side = surfs[0], surfs[-1]
        paint(top, cairo.Matrix(S / 32, -S / 64, S / 32, S / 64, 0, S / 4))
        paint(side, cairo.Matrix(S / 32, S / 64, 0, S / 32, 0, S / 4), 0.2)
        paint(side, cairo.Matrix(S / 32, -S / 64, 0, S / 32, S / 2, S / 2), 0.4)
    out.flush()
    return Gdk.MemoryTexture.new(S, S, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED,
                                 GLib.Bytes.new(bytes(out.get_data())), out.get_stride())


ASSETS = None


def game_icon(item_id=None, text=None, texture=None):
    if ASSETS is None:
        return None
    try:
        return ASSETS.icon(item_id or (ASSETS.find(text) if text else None), texture)
    except Exception:   # a broken model or jar shouldn't take the window down
        return None


def job_icon(c):
    return game_icon("minecraft:cookie" if c.get("child") else JOB_ICONS.get(c["job"]))


def mood_icon(h):
    face = "happy" if h >= 8 else "satisfied" if h >= 6 else "unsatisfied" if h >= 4 else "unhappy"
    return game_icon(texture=f"minecolonies:gui/{face}_icon")


# --- UI -------------------------------------------------------------------------

def label(text, css=None, xalign=0.0, wrap=False, ellipsize=False):
    lbl = Gtk.Label(label=text, xalign=xalign)
    if wrap:
        lbl.set_wrap(True)
        lbl.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if ellipsize:
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
    for c in (css or "").split():
        lbl.add_css_class(c)
    return lbl


def page(*groups, width=900):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
    for g in groups:
        box.append(g)
    clamp = Adw.Clamp(maximum_size=width, child=box)
    clamp.set_margin_top(18)
    clamp.set_margin_bottom(18)
    clamp.set_margin_start(12)
    clamp.set_margin_end(12)
    return Gtk.ScrolledWindow(child=clamp, vexpand=True)


def image(icon, size=32):
    """A themed icon name, or a game texture shown at `size` pixels."""
    if isinstance(icon, str):
        return Gtk.Image.new_from_icon_name(icon)
    img = Gtk.Image.new_from_paintable(icon)
    img.set_pixel_size(size)
    return img


def row(title, subtitle="", suffix=None, suffix_css=None, icon=None, suffix_icon=None):
    r = Adw.ActionRow(title=GLib.markup_escape_text(title),
                      subtitle=GLib.markup_escape_text(subtitle or ""))
    r.set_subtitle_lines(3)
    if icon:
        r.add_prefix(image(icon))
    if suffix:
        r.add_suffix(label(suffix, suffix_css, xalign=1.0))
    if suffix_icon:
        r.add_suffix(image(suffix_icon, 24))
    return r


def citizen_row(c):
    sub = c["job"] + (" · child" if c["child"] else "")
    if c.get("status"):
        sub += f" · {c['status']}"
    elif c.get("asleep"):
        sub += " · Asleep"
    if c.get("health") is not None and c.get("max_health"):
        sub += f" · ♥ {c['health']:.0f}/{c['max_health']:.0f}"
    if c["sick"]:
        sub += f"\nSICK: {item_name(c['sick'])}" + (f" (cure: {c['cure']})" if c.get("cure") else "")
    if c["weak"]:
        sub += " · " + ", ".join(weak_label(raw, w) for _, w, raw in c["weak"][:3])
    h = c["happiness"]
    icon = job_icon(c) or ("face-sick-symbolic" if c["sick"] else "avatar-default-symbolic")
    return row(c["name"], sub, f"{h:.1f}/10", happiness_css(h, c["sick"]), icon, mood_icon(h))


def group(title, rows, empty="Nothing here", description=None):
    g = Adw.PreferencesGroup(title=GLib.markup_escape_text(title))
    if description:
        g.set_description(description)
    if rows:
        for r in rows:
            g.add(r)
    else:
        g.add(row(empty))
    return g


# What non-crafting workers bring in, by building type. Crafters (Sawmill,
# Blacksmith, ...) come from the live export's recipe list instead.
PRODUCERS = {
    "cowboy": ["Raw Beef", "Leather", "Milk Bucket"],
    "chickenherder": ["Raw Chicken", "Egg", "Feather"],
    "shepherd": ["Raw Mutton", "White Wool"],
    "swineherder": ["Raw Porkchop"],
    "rabbithutch": ["Raw Rabbit", "Rabbit Hide"],
    "fisherman": ["Raw Cod", "Raw Salmon"],
    "farmer": ["Wheat", "Wheat Seeds", "Potato", "Carrot", "Beetroot", "Pumpkin", "Melon Slice"],
    "miner": ["Cobblestone", "Cobbled Deepslate", "Raw Iron", "Raw Copper", "Raw Gold", "Coal",
              "Diamond", "Redstone Dust", "Lapis Lazuli", "Emerald", "Gravel", "Dirt"],
}
# The Dining Hall cooks these itself once the raw food arrives.
COOKED = {"Steak": "Raw Beef", "Cooked Chicken": "Raw Chicken", "Cooked Porkchop": "Raw Porkchop",
          "Cooked Mutton": "Raw Mutton", "Cooked Rabbit": "Raw Rabbit", "Cooked Cod": "Raw Cod",
          "Cooked Salmon": "Raw Salmon", "Baked Potato": "Potato", "Fried Egg": "Egg"}


def colony_maker(col, what):
    """The colony building that can supply an item named in a request ("1-48 Raw
    Beef"), or None when only the player can."""
    name = re.sub(r"\s*\(.*\)$", "", re.sub(r"^\d+(-\d+)?\s+", "", what or "")).strip()
    makers = {item: LANG.get(who, who) for item, who in (col.get("crafts") or {}).items()}
    for b in col.get("building_types", []):
        for item in PRODUCERS.get(b, []):
            makers.setdefault(item, building_name(b))
    if name in makers:
        return makers[name]
    if "cook" in col.get("building_types", []) and COOKED.get(name) in makers:
        return f"{building_name('cook')} (from {COOKED[name]})"
    if name.endswith((" Log", " Sapling")) and "lumberjack" in col.get("building_types", []):
        return building_name("lumberjack")
    return None


def player_todo(col):
    """What needs the player: requests the colony can't fill (None without the
    live export), sick citizens, unemployed adults, and complaints that need
    building work, grouped by text."""
    sick = [c for c in col["citizens"] if c["sick"]]
    idle = [c for c in col["citizens"] if c["job"] == "Unemployed" and not c["child"]]
    by_text = {}
    for c in col["citizens"]:
        for q in c["complaints"]:
            # Item shortages already show up as requests.
            if "continue working" not in q["text"]:
                by_text.setdefault(q["text"], []).append(c["name"])
    todo = col.get("todo")
    if todo is not None:
        todo = [t for t in todo if not t.get("maker")]
    return todo, sick, idle, by_text


# Food: a Dining Hall is running low below this many servings per citizen on
# hand (in the hall, the warehouse, or raw in either waiting to be cooked).
FOOD_LOW_PER_CITIZEN = 2
# Citizen saturation: at 0 they stop working and wait at the Dining Hall.
STARVING, HUNGRY = 0, 6


def food_report(col):
    """Each Dining Hall with its servings on hand and a level ('error' out of
    food or no menu, 'warning' running low, 'success' fine), and each menu
    item's supply and level, scarcest first. None without the live export.
    Halls share the warehouse, so with several its stock counts for each."""
    if col.get("dining") is None:
        return None
    people = max(1, len(col["citizens"]))
    report = []
    for d in col["dining"]:
        menu = d["menu"]
        # Each item's fair share of the hall's target, so one plentiful dish
        # doesn't hide the others running out.
        share = FOOD_LOW_PER_CITIZEN * people / max(1, len(menu))
        items = []
        for it in menu:
            supply = it["hall"] + it["warehouse"] + it["raw"]
            level = "error" if supply == 0 else "warning" if supply < share else "success"
            items.append(dict(it, supply=supply, level=level))
        items.sort(key=lambda it: it["supply"])
        meals = sum(it["supply"] for it in items)
        per = meals / people
        level = ("error" if not menu or meals == 0 else
                 "warning" if per < FOOD_LOW_PER_CITIZEN or any(it["level"] == "error" for it in items) else
                 "success")
        report.append(dict(d, items=items, meals=meals, per=per, level=level,
                           in_hall=sum(it["hall"] for it in items)))
    return report


def hungry_citizens(col):
    return sorted((c for c in col["citizens"] if (c.get("saturation") or 0) <= HUNGRY),
                  key=lambda c: c.get("saturation") or 0)


def beds_text(col):
    """'18/18 citizens · no free beds', or just the count when the live export
    (the only source of bed capacity) is missing."""
    n = len(col["citizens"])
    housing = col.get("housing")
    if not housing:
        return f"{n} citizens"
    free = housing["max"] - n
    text = f"{n}/{housing['max']} citizens · " + (f"{free} free bed{'s' * (free != 1)}" if free > 0 else "no free beds")
    if housing["potential"] > housing["max"]:
        text += f" (+{housing['potential'] - housing['max']} in empty guard towers)"
    return text


def happiness_css(h, sick=False):
    return "error" if sick or h < 5 else "warning" if h < 7.5 else "success"


# (name, title, fallback icon, game item for the icon)
SECTIONS = (("dashboard", "Dashboard", "view-grid-symbolic", "minecolonies:clipboard"),
            ("todo", "To do", "object-select-symbolic", "minecraft:writable_book"),
            ("food", "Food", "emoji-food-symbolic", "minecraft:bread"),
            ("requests", "Requests", "mail-send-receive-symbolic", "minecraft:barrel"),
            ("citizens", "Citizens", "system-users-symbolic", "minecraft:name_tag"),
            ("complaints", "Complaints", "dialog-warning-symbolic", None),
            ("visitors", "Visitors", "contact-new-symbolic", "minecraft:emerald"),
            ("bounties", "Bounties", "starred-symbolic", "bountiful:bountyboard"),
            ("research", "Research", "accessories-dictionary-symbolic", "minecolonies:blockhutuniversity"),
            ("feed", "Feed", "format-justify-left-symbolic", "minecraft:oak_sign"))
COMPLAINT_ICON = "minecolonies:gui/unhappy_icon"


class Monitor(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Colony Monitor", default_width=1100, default_height=820)
        self.save_path = None
        self.mtimes = (None, None, None)
        self.last_colony = None
        self.col = None
        self.last_feed = None
        self.last_research = None
        self.research_branch = None

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True)
        self.subtitle = Adw.WindowTitle(title="Colony Monitor", subtitle="Loading…")
        header = Adw.HeaderBar(title_widget=self.subtitle)
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Reload now")
        refresh.connect("clicked", lambda *_: self.reload(force=True))
        header.pack_end(refresh)

        # Sidebar: one row per section, with a count of what's in it.
        self.nav = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.nav.add_css_class("navigation-sidebar")
        self.nav.connect("row-selected", lambda _, r: r and self.stack.set_visible_child_name(r.get_name()))
        self.pages = {}
        for name, title, icon, item in SECTIONS:
            holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.stack.add_named(holder, name)
            box = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
            game = game_icon(item) if item else game_icon(texture=COMPLAINT_ICON)
            box.append(image(game or icon, 24))
            title_lbl = label(title)
            title_lbl.set_hexpand(True)
            box.append(title_lbl)
            badge = label("", "dim-label numeric", xalign=1.0)
            box.append(badge)
            r = Gtk.ListBoxRow(child=box)
            r.set_name(name)
            self.nav.append(r)
            self.pages[name] = (holder, badge, r)
        sidebar = Gtk.ScrolledWindow(child=self.nav, width_request=210,
                                     hscrollbar_policy=Gtk.PolicyType.NEVER)

        self.banner = Adw.Banner()
        body = Gtk.Box()
        body.append(sidebar)
        body.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        body.append(self.stack)
        view = Adw.ToolbarView(content=body)
        view.add_top_bar(header)
        view.add_top_bar(self.banner)
        self.set_content(view)

        self.go("dashboard")
        self.reload(force=True)
        GLib.timeout_add_seconds(POLL_SECONDS, self.reload)

    def go(self, name):
        self.nav.select_row(self.pages[name][2])

    def set_page(self, name, widget, badge=0, alert=True):
        holder, badge_lbl, _ = self.pages[name]
        child = holder.get_first_child()
        scrolls = isinstance(widget, Gtk.ScrolledWindow)
        scroll = child.get_vadjustment().get_value() if scrolls and isinstance(child, Gtk.ScrolledWindow) else 0
        if child:
            holder.remove(child)
        holder.append(widget)
        # Live data refreshes every few seconds; keep the reader's place.
        if scrolls:
            GLib.idle_add(lambda: widget.get_vadjustment().set_value(scroll) and False)
        badge_lbl.set_label(str(badge) if badge else "")
        if alert and badge:
            badge_lbl.add_css_class("warning")
        else:
            badge_lbl.remove_css_class("warning")

    def reload(self, force=False):
        self.save_path = find_save()
        log = os.path.join(INSTANCE, "logs", "latest.log")
        mt = lambda p: os.path.getmtime(p) if p and os.path.exists(p) else None
        mtimes = (mt(self.save_path), mt(log), mt(LIVE_EXPORT))
        if not force and mtimes == self.mtimes:
            return True
        colony_changed = force or mtimes[0] != self.mtimes[0] or mtimes[2] != self.mtimes[2]
        self.mtimes = mtimes

        if colony_changed:
            if not self.save_path:
                self.banner.set_title("No MineColonies world found in this instance")
                self.banner.set_revealed(True)
            else:
                try:
                    col = read_colony(self.save_path)
                    live = read_live(LIVE_EXPORT)
                    if live:
                        col = apply_live(col, live)
                    self.render_colony(col, mtimes[0])
                    # Boards live in region files, which change without the colony changing.
                    self.render_bounties(self.col)
                    self.banner.set_revealed(False)
                except Exception as e:  # mid-write or unexpected layout: keep the last view
                    self.banner.set_title(f"Couldn't read the colony ({e}); retrying")
                    self.banner.set_revealed(True)
                    self.mtimes = (None, mtimes[1], None)
        self.render_feed(read_feed(log))
        return True

    def render_colony(self, col, saved_at):
        # "buildings" is keyed by position tuples (not JSON-able) and isn't shown anyway.
        snapshot = json.dumps({k: v for k, v in col.items() if k != "buildings"}, sort_keys=True, default=str)
        if snapshot == self.last_colony:
            return
        self.last_colony = snapshot
        self.col = col

        world = os.path.basename(os.path.dirname(os.path.dirname(self.save_path)))
        fresh = "live" if col.get("live") else f"saved {time.strftime('%H:%M', time.localtime(saved_at))}"
        self.subtitle.set_title(f"{col['name']} · day {col['day']}")
        self.subtitle.set_subtitle(f"{world} · {fresh} · {beds_text(col)}")

        self.render_todo(col)
        self.render_food(col)

        # Requests + work orders
        self.set_page("requests", page(
            group("Open requests", [self.request_row(r) for r in col["requests"]],
                  "No open requests: everyone has what they need"),
            group("Builder work orders", [self.order_row(o) for o in col["orders"]], "No work orders")),
            len(col["requests"]), alert=False)

        # Citizens: sick first, then unhappiest
        cits = sorted(col["citizens"], key=lambda c: (not c["sick"], c["happiness"]))
        sick = sum(1 for c in col["citizens"] if c["sick"])
        avg = sum(c["happiness"] for c in col["citizens"]) / max(1, len(col["citizens"]))
        self.set_page("citizens", page(group(
            "Citizens", [citizen_row(c) for c in cits], "No citizens",
            f"Average happiness {avg:.1f}/10 · {sick} sick")), sick)

        # Complaints, grouped by text
        by_text = {}
        for c in col["citizens"]:
            for q in c["complaints"]:
                by_text.setdefault(q["text"], []).append(c["name"])
        comp_rows = [row(text, ", ".join(names), f"×{len(names)}", "warning", game_icon(texture=COMPLAINT_ICON))
                     for text, names in sorted(by_text.items(), key=lambda kv: -len(kv[1]))]
        self.set_page("complaints", page(group(
            "What citizens are saying", comp_rows, "No complaints")), len(by_text))

        # Tavern visitors: recruitable for an item; strongest first
        vis_rows = []
        have = colony_jobs(col.get("buildings", {}))
        for v in sorted(col.get("visitors", []), key=lambda v: -sum(v["skills"].values())):
            top = sorted(v["skills"].items(), key=lambda kv: -kv[1])[:3]
            sub = " · ".join(f"{name} {lvl}" for name, lvl in top)
            if v["skills"]:
                if have:
                    sub += "\nYour huts: " + ", ".join(f"{j} {s}" for j, s in best_jobs(v["skills"], only=have))
                sub += "\nAny job: " + ", ".join(f"{j} {s}" for j, s in best_jobs(v["skills"]))
            vis_rows.append(row(v["name"], sub, f"Recruit: {v['cost']}", "accent",
                                game_icon(text=v["cost"]) or "contact-new-symbolic"))
        self.set_page("visitors", page(group(
            "Visitors at the Tavern", vis_rows, "No visitors right now",
            "Talk to a visitor and hand over the item to make them a citizen (needs a free bed)")),
            len(vis_rows), alert=False)

        self.render_research(col)
        self.render_dashboard()

    @staticmethod
    def food_row(it, hall=None):
        """A menu item: total on hand, and where it is."""
        parts = []
        if hall:
            parts.append(hall)
        parts.append(f"{it['hall']} in the hall · {it['warehouse']} in the warehouse")
        if it["raw"]:
            parts.append(f"{it['raw']} {it['raw_name']} to cook")
        sub = " · ".join(parts)
        if it["level"] != "success":
            sub += "\n" + (f"Made by {it['maker']}" if it["maker"] else
                           "Nobody in the colony makes this: bring some or take it off the menu")
        return row(it["name"], sub, str(it["supply"]), it["level"], game_icon(text=it["name"]) or "emoji-food-symbolic")

    @staticmethod
    def hungry_row(c):
        sat = c.get("saturation") or 0
        sub = c["job"] + (f" · {c['status']}" if c.get("status") else "")
        return row(c["name"], sub, f"{sat:.1f}", "error" if sat <= STARVING else "warning",
                   job_icon(c) or "avatar-default-symbolic")

    def render_food(self, col):
        report = food_report(col)
        hungry = hungry_citizens(col)
        groups = []
        if report is None:
            groups.append(group("Dining Halls", [], "Start the game (run /reload once after updating "
                                "colony_export.js) to see Dining Hall menus"))
        elif not report:
            groups.append(group("Dining Halls", [], "No Dining Hall: citizens feed themselves poorly without one"))
        for d in report or []:
            status = {"error": "OUT OF FOOD" if d["menu"] else "NOTHING ON THE MENU",
                      "warning": "running low", "success": "well stocked"}[d["level"]]
            desc = (f"{status.capitalize() if status.islower() else status} · {d['meals']} servings on hand "
                    f"({d['in_hall']} in the hall) for {len(col['citizens'])} citizens, ≈ {d['per']:.1f} each")
            groups.append(group(f"{d['name']} · {d['pos']}", [self.food_row(it) for it in d["items"]],
                                "Nothing on the menu: the cook only fetches what's on it", desc))
        groups.append(group("Hungry citizens", [self.hungry_row(c) for c in hungry], "Everyone has eaten",
                            f"Saturation {HUNGRY} or below, hungriest first. At {STARVING} a citizen stops "
                            "working and waits at the Dining Hall until it serves food."))
        trouble = sum(1 for d in report or [] for it in d["items"] if it["level"] != "success")
        trouble += sum(1 for d in report or [] if not d["menu"])
        self.set_page("food", page(*groups), trouble + sum(1 for c in hungry if (c.get("saturation") or 0) <= STARVING))

    @staticmethod
    def request_row(r):
        sub = r["who"] + (f" · {r['worker']}" if r["worker"] else "")
        if r.get("items"):
            sub += ("\nIn the hut: " if r.get("pickup") else "\n") + ", ".join(r["items"])
        if r.get("resolver") and not r.get("pickup"):
            sub += f"\nHandled by: {r['resolver']}"
        if r.get("waiting"):
            sub += "\nWaiting on: " + ", ".join(r["waiting"])
        icon = game_icon("minecraft:barrel" if r.get("pickup") else None, text=r["what"])
        return row(r["what"], sub, r["state"], "dim-label", icon or "package-x-generic-symbolic")

    @staticmethod
    def order_row(o):
        return row(f"{o['what']} ({o['level']})",
                   f"{o['builder']} · at {o['pos']}" + (f" · {o['resources']} blocks" if o["resources"] else ""),
                   o["stage"], "accent", game_icon("minecolonies:sceptergold") or "applications-engineering-symbolic")

    @staticmethod
    def todo_row(t):
        sub = t["who"] + (f" · {t['worker']}" if t["worker"] else "")
        if t["items"] and t["items"] != [t["what"]]:
            sub += "\n" + ", ".join(t["items"])
        if t.get("maker"):
            return row(t["what"], sub + f"\nMade by: {t['maker']}", "Colony", "dim-label",
                       game_icon(text=t["what"]) or "package-x-generic-symbolic")
        if t["retrying"]:
            sub += "\nNobody in the colony can supply this; it keeps retrying"
        return row(t["what"], sub, "Retrying" if t["retrying"] else "You",
                   "warning" if t["retrying"] else "accent",
                   game_icon(text=t["what"]) or "package-x-generic-symbolic")

    @staticmethod
    def cure_row(c):
        return row(f"{c['name']}: {item_name(c['sick'])}",
                   f"Bring: {c['cure']}" if c.get("cure") else "Check the Hospital", None, None,
                   game_icon(text=c.get("cure")) or game_icon("minecraft:golden_apple") or "face-sick-symbolic")

    @staticmethod
    def fix_rows(idle, by_text):
        rows = [row(f"Give {c['name']} a job", "Unemployed citizens get unhappy", None, None,
                    game_icon("minecraft:name_tag") or "system-users-symbolic") for c in idle]
        rows += [row(text, ", ".join(names), f"×{len(names)}", "warning",
                     game_icon(texture=COMPLAINT_ICON) or "dialog-warning-symbolic")
                 for text, names in sorted(by_text.items(), key=lambda kv: -len(kv[1]))]
        return rows

    def render_todo(self, col):
        """Only what needs the player: requests the colony can't fill, sick
        citizens, unemployed citizens and complaints that need building work."""
        todo, sick, idle, by_text = player_todo(col)
        groups = []
        if todo is None:
            groups.append(group("Bring to the colony", [], "Start the game to see what the colony needs from you",
                                "Needs the live in-game export"))
            todo = []
        else:
            others = len(col["requests"])
            groups.append(group("Bring to the colony", [self.todo_row(t) for t in todo],
                                "Nothing: the Warehouse and couriers have it covered",
                                f"The colony is handling {others} other request{'s' * (others != 1)} by itself"
                                if others else None))
        waiting = [t for t in col.get("todo") or [] if t.get("maker")]
        if waiting:
            groups.append(group("The colony makes these itself", [self.todo_row(t) for t in waiting],
                                description="Nobody had them ready yet; they're waiting on the worker named"))
        groups.append(group("Cure", [self.cure_row(c) for c in sick], "Nobody is sick"))
        groups.append(group("Fix in the colony", self.fix_rows(idle, by_text), "Nothing to fix"))
        self.set_page("todo", page(*groups), len(todo) + len(sick) + len(idle) + len(by_text))

    # status -> (label, css)
    RESEARCH_BADGES = {"done": ("Done", "success"), "running": (None, "accent"),
                       "available": ("Can start", "accent"), "blocked": ("Needs", "warning"),
                       "locked": ("Locked", "dim-label")}

    @classmethod
    def research_row(cls, r, status, percent, reasons, depth):
        bits = [f"Cost: {', '.join(cost_text(c) for c in r['costs'])}" if r.get("costs") else "Free",
                research_duration(r)]
        lines = [" · ".join(bits)]
        effects = [effect_text(e) for e in r.get("effects", [])]
        if effects:
            lines.append("→ " + ", ".join(effects))
        reqs = [requirement_check(q, {})[0].split(" (have")[0] for q in r.get("requirements", [])]
        if status in ("blocked", "locked") and reasons:
            lines.append("Needs: " + ", ".join(reasons))
        elif reqs and status != "done":
            lines.append("Requires: " + ", ".join(reqs))
        if r.get("exclusiveChildResearch"):
            lines.append("Only one of its follow-ups can be researched")
        text, css = cls.RESEARCH_BADGES[status]
        if status == "running":
            text = f"{percent}%"
        r_row = row(research_name(r), "\n".join(lines), text, css)
        r_row.set_subtitle_lines(4)
        # Indent by depth so each research sits under the one it follows.
        prefix = Gtk.Box(spacing=8)
        prefix.append(Gtk.Box(width_request=28 * (depth - 1)))
        icon = game_icon(r.get("icon"))
        prefix.append(image(icon or ("emblem-ok-symbolic" if status == "done" else "view-list-symbolic"), 28))
        r_row.add_prefix(prefix)
        if status in ("blocked", "locked"):
            r_row.add_css_class("dim-label")
        return r_row

    def render_research(self, col):
        """Every research branch as a tree (children under their parent), with
        what each costs, unlocks and still needs before it can start."""
        uni = max((b["level"] for b in col["buildings"].values() if b["type"] == "minecolonies:university"),
                  default=0)
        uni_level = 6 if uni >= 5 else uni
        key = json.dumps([col["research"], uni, sorted((b["type"], b["level"]) for b in col["buildings"].values())],
                         sort_keys=True)
        if key == self.last_research:
            return
        self.last_research = key

        children = {}
        for r in TREE.values():
            children.setdefault(r.get("parentResearch"), []).append(r)
        order = lambda r: (r.get("sortOrder", 999), research_name(r))
        stack = Adw.ViewStack(vexpand=True)
        startable = running = 0
        for bid, b in sorted(TREE_BRANCHES.items(), key=lambda kv: kv[1].get("sortOrder", 999)):
            if b.get("hidden"):
                continue
            rows, counts = [], {}

            def add(r, depth):
                status, percent, reasons = research_status(r, col, TREE, uni_level)
                counts[status] = counts.get(status, 0) + 1
                rows.append(self.research_row(r, status, percent, reasons, depth))
                for child in sorted(children.get(r["id"], []), key=order):
                    add(child, depth + 1)

            for r in sorted((r for r in TREE.values() if r["branch"] == bid and not r.get("parentResearch")), key=order):
                add(r, 1)
            if not rows:
                continue
            startable += counts.get("available", 0)
            running += counts.get("running", 0)
            name = LANG.get(b.get("branch-name", ""), item_name(bid))
            summary = (f"{counts.get('done', 0)} of {len(rows)} done · {counts.get('running', 0)} in progress · "
                       f"{counts.get('available', 0)} can start now")
            stack.add_titled_with_icon(page(group(name, rows, description=summary)), bid, name,
                                       "emblem-ok-symbolic" if counts.get("done", 0) == len(rows) else
                                       "view-list-symbolic")
        if self.research_branch and stack.get_child_by_name(self.research_branch):
            stack.set_visible_child_name(self.research_branch)
        stack.connect("notify::visible-child-name",
                      lambda s, _: setattr(self, "research_branch", s.get_visible_child_name()))

        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=12, margin_start=12,
                         margin_end=12)
        header.append(Adw.ViewSwitcher(stack=stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        header.append(label(f"University level {uni or 'not built'} · {running} in progress · "
                            f"{startable} can start now (University depth limit: {uni_level})"
                            if uni else "Build a University to start research", "dim-label", xalign=0.5))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(header)
        box.append(stack)
        self.set_page("research", box, startable, alert=False)

    def render_bounties(self, col):
        """Bounty boards near you and the Town Hall, best coin rewards first,
        with what the Warehouse already holds towards each one."""
        world = os.path.dirname(os.path.dirname(self.save_path))
        hall = next((b["pos"] for b in col["buildings"].values() if b["type"] == "minecolonies:townhall"), None)
        me = player_pos(world)
        centers = [c for c in (me, (hall[0], hall[2]) if hall else None) if c]
        boards = read_bounties(world, centers) if centers else []
        now = game_time(world)
        stock = {}
        for name, n in (col.get("warehouse") or {}).items():
            iid = (ASSETS.find(name) if ASSETS else None) or name.lower()
            stock[iid] = stock.get(iid, 0) + n
        key = json.dumps([boards, now, stock, me], default=str)
        if key == getattr(self, "last_bounties", None):
            return
        self.last_bounties = key

        origin = centers[0] if centers else (0, 0)
        offers = []
        for b in boards:
            for bounty in b["bounties"]:
                if bounty["expires"] and bounty["expires"] < now:
                    continue
                value = spurs(bounty["rewards"]) - spurs(bounty["objects"])
                if spurs(bounty["rewards"]) == 0 or value <= 0:
                    continue
                have = [(min(stock.get(i, 0), n), n) for logic, i, n in bounty["objects"]
                        if "item" in logic and i not in COIN_SPURS]
                ready = all(got >= n for got, n in have) and len(have) == len(
                    [o for o in bounty["objects"] if o[1] not in COIN_SPURS])
                offers.append((value, ready, b, bounty, have))
        offers.sort(key=lambda o: (-o[1], -o[0]))

        rows = []
        for value, ready, b, bounty, have in offers:
            bring = []
            for logic, i, n in bounty["objects"]:
                text = entry_text(logic, i, n)
                if "item" in logic and i not in COIN_SPURS:
                    text += f" (Warehouse {min(stock.get(i, 0), n)}/{n})"
                bring.append(text)
            left = (bounty["expires"] - now) // 20 // 60 if bounty["expires"] else None
            where = compass(b["pos"][0] - origin[0], b["pos"][2] - origin[1])
            sub = (f"Bring: {', '.join(bring)}\nReward: {', '.join(entry_text(*r) for r in bounty['rewards'])}"
                   f"\nBoard at {fmt_pos(b['pos'])} · {where}" + (f" · ~{left} min left" if left is not None else ""))
            coin = next((i for _, i, _ in bounty["rewards"] if i in COIN_SPURS), None)
            r = row(f"{value} spurs" + (" · Warehouse has everything" if ready else ""), sub,
                    "Ready" if ready else bounty["rarity"].title(), "success" if ready else "dim-label",
                    game_icon(coin) or "starred-symbolic")
            r.set_subtitle_lines(4)
            rows.append(r)

        board_rows = [row(f"Board at {fmt_pos(b['pos'])}",
                          f"{compass(b['pos'][0] - origin[0], b['pos'][2] - origin[1])} · "
                          f"{len(b['bounties'])} bounties" if b["bounties"] else
                          f"{compass(b['pos'][0] - origin[0], b['pos'][2] - origin[1])} · never visited (no bounties yet)",
                          icon=game_icon("bountiful:bountyboard") or "starred-symbolic")
                      for b in sorted(boards, key=lambda b: math.hypot(b["pos"][0] - origin[0], b["pos"][2] - origin[1]))]
        ready_n = sum(1 for o in offers if o[1])
        self.set_page("bounties", page(
            group("Bounties paying coins", rows, "No coin bounties on nearby boards right now",
                  f"Best first; ready-to-hand-in ones on top. Net value counts out any coins a bounty asks for. "
                  f"From the last save; distances from {'you' if me else 'the Town Hall'}. "
                  f"Boards only roll new bounties while you're nearby."),
            group("Boards nearby", board_rows, f"No bounty boards within {BOUNTY_RADIUS} blocks")),
            ready_n, alert=bool(ready_n))

    def tile(self, value, caption, target, css="", icon=None):
        top = Gtk.Box(spacing=12)
        if icon:
            top.append(image(icon, 32))
        top.append(label(str(value), f"title-1 numeric {css}"))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_top=14, margin_bottom=14,
                      margin_start=16, margin_end=16)
        box.append(top)
        box.append(label(caption, "dim-label"))
        button = Gtk.Button(child=box, tooltip_text=f"Open {target.title()}")
        button.add_css_class("card")
        button.connect("clicked", lambda *_: self.go(target))
        return button

    def preview(self, title, rows, empty, target, total):
        g = group(title, rows, empty)
        if total > len(rows):
            more = Gtk.Button(label=f"See all {total}", valign=Gtk.Align.CENTER)
        else:
            more = Gtk.Button(icon_name="go-next-symbolic", tooltip_text="Open", valign=Gtk.Align.CENTER)
        more.add_css_class("flat")
        more.connect("clicked", lambda *_: self.go(target))
        g.set_header_suffix(more)
        g.set_valign(Gtk.Align.START)
        return g

    def render_dashboard(self):
        """Headline numbers (each opens its section) and a short preview of each section."""
        col = self.col
        if col is None:
            return
        todo, sick, idle, by_text = player_todo(col)
        # Builders first: their missing materials hold up construction.
        bring = sorted(todo or [], key=lambda t: "Builder" not in t["who"])
        cits = col["citizens"]
        housing = col.get("housing")
        avg = sum(c["happiness"] for c in cits) / max(1, len(cits))
        need =len(bring) + len(sick) + len(idle) + len(by_text)
        # Same count as the Complaints section (which also lists item shortages).
        complaints = len({q["text"] for c in cits for q in c["complaints"]})
        food = food_report(col)
        worst = (min(food, key=lambda d: ("error", "warning", "success").index(d["level"]))
                 if food else None)

        tiles = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                            min_children_per_line=2, max_children_per_line=5,
                            column_spacing=12, row_spacing=12)
        for t in (self.tile(need, "Need you", "todo", "warning" if need else "success",
                            game_icon("minecraft:writable_book")),
                  self.tile(len(col["requests"]), "Open requests", "requests", "", game_icon("minecraft:barrel")),
                  self.tile(len(col["orders"]), "Builder work orders", "requests", "accent",
                            game_icon("minecolonies:sceptergold")),
                  self.tile(f"{len(cits)}/{housing['max']}" if housing else len(cits),
                            "Citizens / beds" if housing else "Citizens", "citizens",
                            ("success" if housing["max"] > len(cits) else "warning") if housing else "",
                            game_icon("minecraft:name_tag")),
                  self.tile(f"{avg:.1f}", "Average happiness", "citizens", happiness_css(avg), mood_icon(avg)),
                  self.tile(f"{worst['per']:.1f}" if worst else "–",
                            f"Servings per citizen ({worst['name']})" if worst else "Servings per citizen",
                            "food", worst["level"] if worst else "", game_icon("minecraft:bread")),
                  self.tile(len(sick), "Sick", "citizens", "error" if sick else "success",
                            game_icon("minecraft:golden_apple")),
                  self.tile(complaints, "Complaints", "complaints", "warning" if complaints else "success",
                            game_icon(texture=COMPLAINT_ICON)),
                  self.tile(len(col.get("visitors", [])), "Visitors at the Tavern", "visitors", "",
                            game_icon("minecraft:emerald"))):
            tiles.append(t)

        n = 5
        needs_rows = ([self.todo_row(t) for t in bring] + [self.cure_row(c) for c in sick]
                      + self.fix_rows(idle, by_text))
        unhappy = sorted(cits, key=lambda c: (not c["sick"], c["happiness"]))
        feed = list(reversed(self.last_feed or []))
        # Two columns side by side: what to act on, and how the colony is doing.
        left = (self.preview("Needs you", needs_rows[:n],
                             "Nothing to do" if todo is not None else "Start the game to see what's needed",
                             "todo", len(needs_rows)),
                self.preview("Food running low",
                             [self.food_row(it, d["name"]) for d in food or [] for it in d["items"]
                              if it["level"] != "success"][:n],
                             "Start the game to see Dining Hall menus" if food is None else
                             "Every Dining Hall is well stocked",
                             "food", sum(1 for d in food or [] for it in d["items"] if it["level"] != "success")),
                self.preview("Being built", [self.order_row(o) for o in col["orders"][:n]], "No work orders",
                             "requests", len(col["orders"])))
        right = (self.preview("Lowest happiness", [citizen_row(c) for c in unhappy[:n]], "No citizens",
                              "citizens", len(unhappy)),
                 self.preview("Latest chat", [row(text, when, icon=game_icon("minecraft:oak_sign"))
                                              for when, text in feed[:n]],
                              "Nothing yet; start the game", "feed", len(feed)))
        previews = Gtk.Box(spacing=18, homogeneous=True)
        for groups in (left, right):
            column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, valign=Gtk.Align.START)
            for g in groups:
                column.append(g)
            previews.append(column)
        self.set_page("dashboard", page(tiles, previews, width=1400))

    def render_feed(self, feed):
        # The log grows constantly; only rebuild (and lose scroll) when chat changed.
        if feed == self.last_feed:
            return
        self.last_feed = feed
        sign = game_icon("minecraft:oak_sign")
        rows = [row(text, when, icon=sign) for when, text in reversed(feed)]
        self.set_page("feed", page(group("Colony chat (newest first)", rows,
                                         "Nothing yet; start the game")))
        self.render_dashboard()


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="io.lajna.ColonyMonitor")

    def do_activate(self):
        win = self.props.active_window or Monitor(self)
        win.present()


if __name__ == "__main__":
    try:
        ASSETS = GameAssets()
    except Exception as e:   # icons are a nicety; fall back to theme icons
        print(f"colony-monitor: no game icons ({e})", file=sys.stderr)
    sys.exit(App().run([sys.argv[0]]))
