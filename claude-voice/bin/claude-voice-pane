#!/usr/bin/env bash
# Runs inside the Claude tmux pane (env set by claude-voice). Stock Claude Code + voice prompt.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec claude --permission-mode auto \
  --append-system-prompt "$(sed "s|@ROOT@|$ROOT|g" "$ROOT/config/voice-prompt.md")" "$@"
