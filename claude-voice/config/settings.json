{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(voice-show:*)",
      "Bash(voice-say:*)",
      "Bash(voice-session:*)",
      "Bash(@ROOT@/bin/voice-show:*)",
      "Bash(@ROOT@/bin/voice-say:*)",
      "Bash(@ROOT@/bin/voice-session:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "@ROOT@/.venv/bin/claude-voice-hook ask", "timeout": 300 }]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "@ROOT@/.venv/bin/claude-voice-hook permission", "timeout": 300 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "@ROOT@/.venv/bin/claude-voice-hook stop", "timeout": 10 }]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [{ "type": "command", "command": "@ROOT@/.venv/bin/claude-voice-hook display", "timeout": 5 }]
      }
    ]
  }
}
